@Metadata.layer: #CORE

annotate entity ZC_ProcurementItem with
{
  @UI.facet: [
    { id: 'ItemHeader', purpose: #HEADER, type: #FIELDGROUP_REFERENCE, targetQualifier: 'ItemData' },
    { id: 'AccountFacet', purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'Account Assignments', targetElement: '_AccountAssignment' }
  ]

  @UI.lineItem: [{ position: 10 }]
  @UI.fieldGroup: [{ qualifier: 'ItemData', position: 10 }]
  ItemNumber;

  @UI.lineItem: [{ position: 20 }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_MaterialVH', element: 'MaterialID' } }]
  MaterialID;

  @UI.lineItem: [{ position: 30 }]
  Plant;

  @UI.lineItem: [{ position: 40 }]
  Quantity;

  @UI.lineItem: [{ position: 50 }]
  ItemAmount;

  @UI.lineItem: [{ position: 60 }]
  RequiredDeliveryDate;
}